{
  "server": {
    "http_addr": ":19087",
    "shutdown_timeout": "10s"
  },
  "smpp": {
    "addr": ":29175",
    "system_id": "mysmpp",
    "password": "CHANGE_ME_BEFORE_DEPLOY",
    "system_type": "gateway",
    "max_sessions": 128,
    "window_size": 16,
    "enquire_period": "30s"
  },
  "dispatcher": {
    "workers": 10,
    "per_worker_concurrency": 10,
    "claim_limit": 20,
    "poll_interval_ms": 20,
    "pending_ttl": "30m",
    "max_attempts": 5
  },
  "esmes": [
    {
      "system_id": "esme1",
      "password": "CHANGE_ME_BEFORE_DEPLOY"
    },
    {
      "system_id": "load-tester",
      "password": "CHANGE_ME_BEFORE_DEPLOY"
    }
  ],
  "routes": [
    {
      "name": "china-mobile",
      "prefix": ["134", "135", "136", "137", "138", "139"],
      "provider": "provider-a",
      "priority": 100
    },
    {
      "name": "default",
      "prefix": [],
      "provider": "provider-b",
      "priority": 1
    }
  ],
  "providers": [
    {
      "name": "provider-a",
      "protocol": "mock",
      "endpoint": "",
      "rule": "http-form-a",
      "enabled": true,
      "http_timeout_ms": 3000,
      "rate_limit": {
        "tps": 200,
        "burst": 400,
        "timeout_ms": 2000
      }
    },
    {
      "name": "provider-b",
      "protocol": "mock",
      "endpoint": "",
      "rule": "http-json-b",
      "enabled": true,
      "http_timeout_ms": 3000,
      "rate_limit": {
        "tps": 200,
        "burst": 400,
        "timeout_ms": 2000
      }
    }
  ],
  "inbound": [
    {
      "name": "partner-callback",
      "method": "POST",
      "path": "/callback/partner",
      "content_type": "application/json",
      "auth_header": "X-Token",
      "auth_token": "CHANGE_ME_BEFORE_DEPLOY",
      "fields": {
        "id": "msg_id",
        "from": "src",
        "to": "dst",
        "text": "content"
      },
      "success_status": 200,
      "success_body": "{\"status\":\"ok\"}"
    }
  ],
  "outbound": [
    {
      "name": "http-form-a",
      "method": "POST",
      "content_type": "application/x-www-form-urlencoded",
      "fields": {
        "account": "account",
        "mobile": "to",
        "src": "from",
        "msg": "text"
      },
      "headers": {
        "X-Request-ID": "{{id}}"
      }
    },
    {
      "name": "http-json-b",
      "method": "POST",
      "content_type": "application/json",
      "fields": {
        "messageId": "id",
        "sender": "from",
        "receiver": "to",
        "body": "text",
        "coding": "encoding"
      }
    }
  ],
  "clients": [
    {
      "client_id": "demo-client",
      "token": "CHANGE_ME_BEFORE_DEPLOY",
      "enabled": true,
      "allowed_ips": ["127.0.0.1/32", "::1/128"]
    }
  ],
  "trusted_proxies": ["127.0.0.1/32", "::1/128"],
  "risk": {
    "blocked_to_prefix": [],
    "blocked_keywords": [],
    "per_number_per_minute": 5,
    "per_number_per_day": 20,
    "per_client_per_second": 500
  },
  "storage": {
    "driver": "postgres",
    "dsn": "postgres://mysmpp:CHANGE_ME_BEFORE_DEPLOY@127.0.0.1:5432/mysmpp?sslmode=disable&pool_max_conns=50&pool_min_conns=10"
  },
  "admin": {
    "username": "admin",
    "password": "CHANGE_ME_BEFORE_DEPLOY"
  }
}
